# "dev": nenhum e-mail real é enviado (as mensagens são salvas em DEV_OUTBOX_DIR para pré-visualização).
# "production": envia via SMTP; o servidor não inicia se o SMTP não estiver configurado.
APP_MODE=dev

# Origens permitidas pelo CORS (separadas por vírgula). Só necessário se o frontend rodar em outro domínio.
CORS_ORIGINS=http://localhost:5173

# Apenas em dev: pasta onde os e-mails simulados são gravados (contém os resultados! nunca use em produção).
DEV_OUTBOX_DIR=dev_outbox

# --- SMTP (obrigatório em produção) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=amigo-secreto@example.com
MAIL_FROM_NAME=Amigo Secreto

# Tempo (minutos) que um sorteio com falha de envio fica na memória para permitir reenvio.
EVENT_TTL_MINUTES=120
# Máximo de requisições de sorteio/reenvio por IP por minuto.
RATE_LIMIT_PER_MINUTE=10
